          "accent": "tertiary",
          "surface": "tertiary"
        },
        "emphasis": "high",
        "surfaces": {
          "hero": "tertiary",
          "cards": "container",
          "sections": ["tertiary-container", "container"]
        },
        "lozengeUsage": "frequent",
        "contrastMode": "high"
      },
      "characteristics": {
        "boldness": "high",
        "playfulness": "high",
        "professionalism": "medium"
      }
    },
    "professional": {
