{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio --port 5555",
    "type-check": "tsc --noEmit",
    "clean": "rimraf generated"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./generated/zod": {
      "import": "./generated/zod/index.js",
      "require": "./generated/zod/index.js",
      "types": "./generated/zod/index.d.ts"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.0",
    "zod-prisma-types": "^3.3.11"
  }
}
