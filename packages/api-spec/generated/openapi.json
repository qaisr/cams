{
  "openapi": "3.0.0",
  "info": {
    "title": "App API",
    "version": "1.0.0",
    "description": "Customer Account Management System API"
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "db": {
            "type": "string",
            "enum": [
              "connected",
              "disconnected"
            ]
          }
        },
        "required": [
          "status",
          "timestamp",
          "db"
        ]
      },
      "AuthUser": {
        "type": "object",
        "properties": {
          "sub": {
            "type": "string"
          },
          "lanId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "iat": {
            "type": "number"
          },
          "exp": {
            "type": "number"
          }
        },
        "required": [
          "sub",
          "lanId",
          "name",
          "email",
          "groups",
          "iat",
          "exp"
        ]
      },
      "LoginReal": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "redirectUri": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "code",
          "redirectUri"
        ]
      },
      "LoginMock": {
        "type": "object",
        "properties": {
          "lanId": {
            "type": "string",
            "minLength": 1
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "lanId",
          "groups"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "properties": {
              "sub": {
                "type": "string"
              },
              "lanId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "iat": {
                "type": "number"
              },
              "exp": {
                "type": "number"
              }
            },
            "required": [
              "sub",
              "lanId",
              "name",
              "email",
              "groups",
              "iat",
              "exp"
            ]
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "EffectivePermissions": {
        "type": "object",
        "properties": {
          "lanId": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effectivePermissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isSuperadmin": {
            "type": "boolean"
          }
        },
        "required": [
          "lanId",
          "groups",
          "effectivePermissions",
          "isSuperadmin"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns API and database connectivity status",
        "tags": [
          "Health"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Service health status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Login",
        "description": "Authenticate and receive a JWT. Use LoginReal for production (PKCE), LoginMock when MOCK_AUTH_ENABLED=true.",
        "tags": [
          "Auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/LoginReal"
                  },
                  {
                    "$ref": "#/components/schemas/LoginMock"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "summary": "JWKS endpoint (local dev only)",
        "description": "Returns the public key set for mock JWT validation. Only available when MOCK_AUTH_ENABLED=true.",
        "tags": [
          "Auth"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "JSON Web Key Set",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "keys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "keys"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/me/permissions": {
      "get": {
        "summary": "Get effective permissions",
        "description": "Returns the effective permissions for the currently authenticated user.",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Effective permissions for the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EffectivePermissions"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  }
}