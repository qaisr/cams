{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@repo/database": ["../../packages/database/src/index.ts"],
      "@repo/database/generated/zod": [
        "../../packages/database/generated/zod/index.ts"
      ],
      "@repo/shared-config": ["../../packages/shared-config/src/index.ts"],
      "@repo/validation": ["../../packages/validation/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "coverage", "**/generated/**"]
}
