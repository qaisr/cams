{
  "root": true,
  "ignorePatterns": ["node_modules/", "dist/", ".next/", "target/", "generated/", "*.d.ts"],
  "overrides": [
    {
      "files": ["*.js"],
      "extends": ["eslint:recommended"],
      "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module"
      },
      "env": {
        "node": true,
        "es2022": true
      }
    }
  ]
}
