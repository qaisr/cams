# Dependencies
node_modules/
**/node_modules/**
.pnp
.pnp.js
.pnpm-store/

# OS
.DS_Store
**/.DS_Store
Thumbs.db

# Build outputs
dist/
.next/
target/
out/
build/
*.tsbuildinfo

# Compiled TypeScript outputs in apps/ (jest configs, etc.)
# Note: packages/*/src/*.js are intentionally committed for monorepo package distribution
apps/*/*.js
apps/*/*.js.map
apps/*/*.d.ts
apps/*/*.d.ts.map

# credentials
credentials/
application-local.yml

# Generated code
tmp/
.github/prompts

# Generated — committed only when explicitly needed (api-spec is committed)
packages/database/generated/
apps/web/src/hooks/generated/
apps/web/src/mocks/generated/
apps/web/src/types/generated/

# Environment files
.env
.env.local
*.env.local
.env.*.local

# Stage-specific local env files (created by developers for CDK dry-runs — never commit)
.env.dev
.env.staging
.env.prod
.env.production
local.env.json

# Keep examples
!.env.example
!.env.*.example
!local.env.json.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# AWS / Infrastructure
cdk.out/
*.tfstate
*.tfstate.backup
.cdk.staging/
.aws/

# LocalStack
.localstack/

# IDE
.vscode/*
!.vscode/settings.json      # Commit — shared team settings
!.vscode/extensions.json    # Commit — recommended extensions
!.vscode/launch.json        # Commit — debug configs
.idea/
*.swp
*.swo
*.iml
prompts

# Test artifacts
playwright-report/
tmp-playwright/
.playwright-mcp/
test-results/
e2e/.auth/

# Playwright auth state — contains session tokens, never commit
apps/web/e2e/.auth/

# Live credentials
apps/web/.env.e2e.local

# Test artifacts
apps/web/playwright-report/
apps/web/test-results/

# Storybook build output
storybook-static/
apps/web/storybook-static/

# Testing Coverage
coverage/
.nyc_output/
lcov.info
coverage.xml

# Claude Code local settings
.claude/settings.local.json
.claude/browser-reports/
.claude/logs/
.claude/browser-actions.json
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock

# Cache
.turbo/
.eslintcache
.prettiercache
*.tsbuildinfo
.swc/

# Extras
tmp
.favorites.json

# Security scan output (local debugging only)
.snyk-results.json
.gitleaks-report.json

# Export outputs (/export, /create-presentation) — binaries/rasters regenerated on demand
specs/exports/**/*.pdf
specs/exports/**/*.docx
specs/exports/**/*.pptx
specs/exports/**/*.html
specs/exports/**/*.png
specs/exports/**/*.svg
specs/exports/.tmp/
# Keep the editable slide sources so /audit-presentation can revise them
!specs/exports/presentations/*.slides.md

# Generated pandoc reference templates — regenerated per generate-ppcc-templates.md
.claude/assets/export/ppcc-reference.docx
.claude/assets/export/ppcc-reference.pptx

raw-specs/
raw-requirements/

# JIRA + Confluence mirrors — derived/regenerable files are gitignored.
# Committed as authoritative sync / citation-cache state: sidecars, .manifest.json,
# per-epic/per-space manifests, .md bodies (01a §3.5, 01c §3.1).
jira/_index.json
confluence/_index.json
# Transient batched-sync run-state (one tracker per large-scale --pull run) and the
# write-back engines' crash-safe run-manifests — reconstructable from sidecars, same
# category as _index.json.
jira/.pull-runs/
confluence/.pull-runs/
jira/.push-runs/
confluence/.push-runs/
# people.json is regenerated by /jira-init from live Atlassian assignees
.claude/config/people.json

# Figma derived state (regenerable — Plan 02 D3)
figma/_index.json
figma/_designers.json

# Token-drift resolved output (Style Dictionary build — regenerable, Plan 02b F3)
.claude/.token-drift/
