# =============================================================================
# Environment Variables — Copy to .env.local and fill in values
# See scripts/check-env.ts for validation
# NEVER commit real values — only this example file
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database (Postgres) ──────────────────────────────────────────────────────
# Local dev: matches docker-compose.yml service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_local

# ─── Authentication (PingID) ──────────────────────────────────────────────────
PINGID_JWKS_URI=https://auth.pingone.com/.well-known/jwks.json
PINGID_ISSUER=https://auth.pingone.com
PINGID_AUDIENCE=app-api

# Enable mock auth for local dev without real PingID credentials
MOCK_AUTH_ENABLED=true

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-2

# LocalStack — set for local dev, unset in production
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ─── EventBridge ──────────────────────────────────────────────────────────────
EVENT_BUS_NAME=app-local-bus

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
# NEXT_PUBLIC_* vars are exposed to the browser — never put secrets here
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_ENV=local
API_INTERNAL_BASE_URL=http://localhost:3001

# ─── MSW (Mock Service Worker) ────────────────────────────────────────────────
NEXT_PUBLIC_API_MODE=real

# ───  SYNK_API_KEY  ────────────────────────────────────────────────
SYNK_API_KEY=
SNYK_TOKEN=
