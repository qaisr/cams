{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/apps/api/src/main",
    "start:dev": "nest start --watch",
    "test": "jest --config jest.config.ts --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.ts --runInBand --passWithNoTests",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-eventbridge": "^3.1079.0",
    "@aws-sdk/rds-signer": "^3.1079.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@repo/database": "workspace:*",
    "@repo/shared-config": "workspace:*",
    "@repo/validation": "workspace:*",
    "aws-xray-sdk-core": "^3.12.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "nestjs-zod": "^5.4.0",
    "passport": "^0.7.0",
