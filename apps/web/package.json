{
  "name": "@repo/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src app --max-warnings=0",
    "lint:fix": "eslint src app --fix",
    "type-check": "tsc --noEmit",
    "orval": "orval --config orval.config.ts",
    "orval:msw": "orval --config orval.msw.config.ts",
    "clean": "rimraf .next coverage out",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "storybook:test": "test-storybook --watch",
    "storybook:a11y": "test-storybook --testMatch '**/*.a11y.test.ts'"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@lumen/react": "^1.4.1",
    "@repo/shared-config": "workspace:^",
    "@repo/validation": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "clsx": "^2.1.1",
    "next": "16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/test-runner": "^0.24.4",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-fixed-jsdom": "^0.0.11",
    "msw": "^2.14.6",
    "orval": "^8.19.0",
    "rimraf": "^6.1.3",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.2",
    "ts-jest": "^29.4.11"
  }
}
